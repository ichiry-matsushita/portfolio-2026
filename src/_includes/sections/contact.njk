<section class="section" id="contact" aria-labelledby="contact-heading">
  <div class="container">
    <div class="contact">
      <p class="eyebrow eyebrow--on-dark">{{ contact.label }}</p>
      <h2 class="contact__title" id="contact-heading">{{ contact.heading }}</h2>
      <p class="contact__lead">{{ contact.lead }}</p>
      <div class="button-group">
        <a class="button button--white" href="{{ contact.fukugyoUrl }}">複業クラウドで相談する</a>
        <a class="button button--outline-white" href="mailto:{{ contact.email }}">{{ contact.email }}</a>
      </div>
    </div>
  </div>
</section>
